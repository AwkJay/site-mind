.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Runtime-generated, not source. Eval report JSONs are deliberately NOT
# ignored — they're the evidence behind every metric claimed in PROGRESS.md.
data/traces/

# Local JSONL audit ledger fallback (plan §D) — regenerated on every boot via
# the startup seed hook when MONGODB_URI is unset; not source, not evidence
# for any claimed metric (unlike the eval reports above).
data/audit_events.jsonl

# Disk-backed LLM response cache (app/llm_cache.py) — cached model output,
# regenerated by hitting the live provider or by backend/scripts/warm_llm_cache.py.
# Not source, not evidence for any claimed metric.
data/.llm_cache/

