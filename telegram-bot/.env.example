# SiteMind field bot runtime config (plan §F1). Copy to .env, fill in real
# values. NEVER commit the real .env — see ../.gitignore.

TELEGRAM_BOT_TOKEN=
ELEVENLABS_API_KEY=
# Multilingual voice — eleven_multilingual_v2 handles the reply language
# regardless of this voice's "native" accent.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Translation only (Hindi/regional <-> English) — same provider as the main
# backend's Workstream A. Optional: if empty, the bot skips translation and
# assumes English in/out.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# The FastAPI backend's /api/copilot/chat (multi-turn Copilot agent, needs
# COPILOT_AGENT_ENABLED=1 + RETRIEVAL_ENABLED=1 on the backend) — falls back
# to the single-shot answerer if the agent is off. This bot is a pure client.
BACKEND_URL=http://localhost:8000
